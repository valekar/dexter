# =============================================
# Dexter Environment Template (Mar 2026)
# Copy this file to .env and fill in real values.
# =============================================

# -----------------------------
# 1) LLM Provider Keys
# -----------------------------
# REQUIRED: set at least ONE provider key below.
# If you do nothing else, set OPENAI_API_KEY (default model path).
OPENAI_API_KEY=your-openai-api-key

# Optional alternate LLM providers
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=
MOONSHOT_API_KEY=
DEEPSEEK_API_KEY=

# MiniMax (newly integrated, OpenAI-compatible)
MINIMAX_API_KEY=
# Optional override (default is already correct)
# MINIMAX_BASE_URL=https://api.minimax.io/v1

# LM Studio (OpenAI-compatible local server)
# If you set host only, Dexter auto-normalizes to /v1 internally.
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
# Optional if your LM Studio server requires auth
LMSTUDIO_API_KEY=

# Ollama (only if running local models)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Dexter runtime
# Maximum tool-calling loop iterations per query (default: 10)
DEXTER_MAX_ITERATIONS=20

# -----------------------------
# 2) Financial Data Providers
# -----------------------------
# RECOMMENDED for fundamentals/filings/metrics (US-heavy data)
FINANCIAL_DATASETS_API_KEY=your-financial-datasets-api-key
ENABLE_FINANCIAL_DATASETS=true

# Yahoo Finance is free/no key required (keep enabled unless debugging)
ENABLE_YAHOO=true

# Groww (optional, Indian broker + trading APIs)
GROWW_API_KEY=
GROWW_API_SECRET=
ENABLE_GROWW=false

# Zerodha (optional, Indian broker + trading APIs)
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_ACCESS_TOKEN=
ENABLE_ZERODHA=false

# -----------------------------
# 3) Web Search Tool (Optional)
# -----------------------------
# Dexter enables web_search if one key is present.
# Priority: EXA -> PERPLEXITY -> TAVILY
EXASEARCH_API_KEY=
PERPLEXITY_API_KEY=
TAVILY_API_KEY=

# -----------------------------
# 4) Optional Observability
# -----------------------------
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=dexter
LANGSMITH_TRACING=false

# -----------------------------
# 5) Optional Gateway/Session paths
# -----------------------------
# DEXTER_GATEWAY_CONFIG=
# DEXTER_PAIRING_PATH=
# DEXTER_SESSIONS_DIR=
